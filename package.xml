<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>topsbot_webviz</name>
  <version>0.2.0</version>
  <description>TOPSBOT Web inference visualization (C++ libwebsockets + browser Canvas).</description>

  <maintainer email="developer@topsfuture.com">TOPSBOT</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>libwebsockets-dev</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>tb_img_msgs</build_depend>
  <build_depend>tb_det_msgs</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>protobuf-compiler</build_depend>
  <build_depend>libprotobuf-dev</build_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tb_img_msgs</exec_depend>
  <exec_depend>tb_det_msgs</exec_depend>
  <exec_depend>libwebsockets16</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
